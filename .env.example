# 恒发内勤 Agent 一期 · 后端环境变量样例
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，严禁提交。
# 生产密钥只通过密钥管理注入（规格 15.2）。
#
# 注意：VITE_API_BASE_URL 属前端变量，写入 frontend/.env.example，不在此文件。

# 模型接入（规格 0.3：LangChain 通用 ChatModel 接口）
MODEL_NAME=deepseek-v4-flash
MODEL_BASE_URL=
MODEL_API_KEY=
# 思考模式档位：low/medium/high/off，空串=保持 API 默认（deepseek-v4-flash 默认开启思考）。
# 改动后重启后端生效
MODEL_REASONING_EFFORT=medium
# 模型调用瞬时故障重试次数上限（连接失败/HTTP 429/5xx；0=关闭重试保持 fail closed）
MODEL_CALL_MAX_RETRIES=2

# ERP MCP（规格 0.3：MCP Streamable HTTP；内网 HTTP 无 TLS）
# 认证 X-API-Key 优先（mcp-api.md §1）；ERP_MCP_JWT 为 Bearer 回退通道（一期不使用）
ERP_MCP_URL=
ERP_MCP_API_KEY=
ERP_MCP_JWT=
# 连接/读取/总超时（秒，规格 13.3）；元数据缓存有效期（秒，规格 2.3 失效后刷新）
ERP_MCP_CONNECT_TIMEOUT=5
ERP_MCP_READ_TIMEOUT=30
ERP_MCP_TOTAL_TIMEOUT=60
ERP_MCP_METADATA_TTL=3600
# 瞬时故障重试次数上限（404/5xx/连接失败；0=关闭重试保持 fail closed）
ERP_MCP_MAX_RETRIES=3

# RAG 长期记忆 MCP（同级仓库 hengfa-rag；独立服务/独立进程，MCP Streamable HTTP，
# POST /mcp，X-API-Key 认证）。与 ERP MCP 是两个独立客户端实例。
# RAG_MCP_URL 或 RAG_MCP_API_KEY 任一为空 = 不启用长期记忆：不向模型暴露
# rag_remember/rag_recall/rag_forget 三个工具并打一条 rag_mcp_unconfigured 启动
# 告警，agent 其余能力照常工作（RAG 不是启动依赖，未配置不影响启动）。
# RAG_MCP_API_KEY 属敏感凭据（已登记 SENSITIVE_SETTINGS），只经环境注入。
# [2026-09-22 G1] 超时/重试**独立**于 ERP_MCP_*：RAG 每次调用含一次云端嵌入
# API 调用，比 ERP 本地查询慢，复用 ERP 旋钮会把云端抖动误判为 ERP 超时口径。
# [2026-09-23 按实测重定] 真调 DashScope 原生多模态端点（qwen3-vl-embedding，86
# 次）实测：正常 p50 0.14–0.22s / p90≈0.75s / max≈0.85s，但有 5.8% 的新建连接
# 长尾落在 21.2–21.3s（HTTP 200，成功但极慢）；RAG 侧嵌入客户端 httpx 超时是
# 30s，故这类长尾会被 RAG 容忍并成功返回。read 必须 > 实测合法长尾 21.3s 并取
# 到 RAG 每尝试预算 30s，**让被调用方先返回结构化错误、而不是调用方先超时**。
# 生效 connect=min(3,66/4)=3、read=min(30,(66-6)/2)=30；最坏墙钟 ≈ 2×(2×3+2×30)
# = 132s（max_retries=1 即 2 次尝试，另加一次 1s 退避）。
# 生效的 connect/read 由 client 按 total 收敛（connect≤total/4；read≤(total-2×connect)/2）。
# [2026-09-23 P3 补句] 实话：read=30 只覆盖**实测到的那条 21.2–21.3s 建连长尾**
# （21.3 < 30，方向正确），**不是**「被调用方一定会先返回结构化错误」的保证。
# 上游进入「慢 + 重试风暴」形态时**调用方仍会先超时**，拿到
# MCP_TIMEOUT_RESULT_UNKNOWN（不可重试、无 reason）；把 read 抬到 40–45s 也
# 改变不了这一点——RAG 的嵌入客户端自己会重试（hengfa-rag embedding.py
# _embed_batch 捕获 httpx.TimeoutException、MAX_RETRIES=3、退避 1/2/4），慢形态
# 下要 ≥127s 才返回 embedding_unavailable（4×30+7 是下界——httpx 按操作计时，
# 一次 post 可吃满 connect 30 + read 30 = 60s，最坏 4×60+7 = 247s；RAG MCP 层
# 无外层超时，调用方是唯一封顶者）；覆盖它得把 read 抬到 ~250s 量级，更不值得。
# 另：F2 的 retryable 重试放行只在「快速失败」形态下可达（429/5xx 立刻返回 →
# RAG 退避几秒就给结构化错误），**别当成「RAG 抖动会自愈」的保证**。
RAG_MCP_URL=
RAG_MCP_API_KEY=
RAG_MCP_CONNECT_TIMEOUT=3
RAG_MCP_READ_TIMEOUT=30
RAG_MCP_TOTAL_TIMEOUT=66
# RAG 瞬时故障重试次数上限（F2 修好后，服务端声明 retryable=true 的错误
# ——embedding_unavailable / store_unavailable——会自动重试；0=不重试）
RAG_MCP_MAX_RETRIES=1

# Agent 自有数据库（PostgreSQL 16，规格 0.3 / 12 章）
AGENT_DATABASE_URL=
CHECKPOINT_DATABASE_URL=

# 会话与安全（规格 12.4：凭据只进 .env；12.1 无用户表，账号密码来自环境）
SESSION_SECRET=
# manager 账号唯一来源（JSON 列表：加 manager 只改本行 + docker compose up -d，
# 无需改代码/发版）。**必须写成单行**：不能跨行的不是 JSON——`json.loads` 完全
# 容忍条目内空格与换行——而是 dotenv/compose 的 `.env` 行解析：跨行写的值会被
# 截断成非法 JSON，从而 api 启动即失败。口令建议用 openssl rand -hex 生成纯十六
# 进制，务必**避开 `$`**：compose 与 dotenv 都会对 `$` 做变量插值/展开（实测
# `pw$ecret` 被吃成 `pw`、`pw${HOME}` 被展开成路径并直接 ValidationError 起不来）。
# 旧键 MANAGER_ACCOUNT / MANAGER_PASSWORD / MANAGER_ACCOUNT_2 / MANAGER_PASSWORD_2
# 已作废，写了不生效。
# 凭据顺序 = 列表顺序（其后追加 developer）；重名「首个生效、后者丢弃」；
# 条目 account/password 任一为空 = 整条丢弃；列表为空 = 无 manager 可登录。
# JSON 语法/键名写错 = api 直接起不来（响亮，部署前先校验），不会静默变成"没人能登录"。
# 示例（单引号包裹防 shell 展开）：MANAGER_ACCOUNTS='[{"account":"hengfa","password":"<hex>"}]'
MANAGER_ACCOUNTS=
DEVELOPER_ACCOUNT=
DEVELOPER_PASSWORD=
# 会话有效期（分钟）；生产建议不超过 480
SESSION_TTL_MINUTES=480
# 生产必须 True（浏览器 Cookie Secure 属性）；本地 http 联调置 False
COOKIE_SECURE=false
# Cookie SameSite 属性（lax/strict/none）
COOKIE_SAMESITE=lax

# 可观测性（规格 0.3：structlog JSON）
LOG_LEVEL=INFO

# 数据保留（规格 12.3）
CHECKPOINT_RETENTION_DAYS=30

# 优雅停机（规格 15.3 步骤 7）：等待进行中写调用落审计的超时秒数
SHUTDOWN_DRAIN_TIMEOUT=30

# 独立前端来源白名单（规格 2.6 web/cors.py；D22 启用）
FRONTEND_ORIGIN=http://localhost:5173

# 对话对账附件与导出文件（对话上传 Excel 对账 + 对话导出；空串 = 对应功能不启用，
# 生产启用需配合 docker compose 卷挂载持久目录）
# 附件临时目录（空串=不启用附件功能）
ATTACHMENT_DIR=
# 附件大小上限（字节；10MB）
ATTACHMENT_MAX_BYTES=10485760
# 附件保留时长（秒；1h，启动时 + 每次上传时清过期）
ATTACHMENT_TTL_SECONDS=3600
# 导出文件目录（空串=不启用导出功能）
EXPORT_DIR=
# 单次导出行数上限（超限 fail closed，提示加过滤条件）
EXPORT_MAX_ROWS=50000
# 导出文件保留时长（秒；1h，启动时 + 每次导出时清过期）
EXPORT_FILE_TTL_SECONDS=3600
# 对账报告保留时长（秒；24h，跨轮确认窗口）
RECONCILE_REPORT_TTL_SECONDS=86400

# ---------- docker compose 部署变量（D25/RV-38；本机/单机部署形态） ----------
# 以下变量供 docker-compose.yml 插值使用（15.2 凭据纪律：口令只经环境变量
# 注入，样例不写真实密钥，敏感值留空由生产密钥管理覆盖）。
# PostgreSQL 口令（db 服务；本地演示默认 agent_demo_pw，生产必须覆盖）
POSTGRES_PASSWORD=agent_demo_pw
# 数据库名（部署默认 agent；演练脚本使用独立演练库）
POSTGRES_DB=agent
# 反向代理登录防爆破限速（RV-06 决策项 a：网关层配置位，nginx limit_req；
# 触发后返回标准 429，Agent 侧仅保留 429 错误契约）
NGINX_LOGIN_RATE=5r/m
NGINX_LOGIN_BURST=5
# 本机回环入口端口（web 服务；生产接受管反代后按需调整）
WEB_PORT=8080

# ---------- 上下文与压缩预算（高级调优项；默认值即 config.py 默认，通常无需修改） ----------
# 对话压缩分层阈值（会话消息条数，JSON 数组格式）
COMPRESSION_TIERS=[30,60,90]
# 每层最多压缩次数
MAX_COMPRESSIONS_PER_TIER=2
# 对话上下文字符预算（超限触发压缩路由）
DIALOGUE_BUDGET_CHARS=140000
# 单条摘要最大字符数
SUMMARY_MAX_CHARS=1500
# 摘要 token 占模型上下文比例上限
SUMMARY_TOTAL_BUDGET=0.10
# 压缩生成摘要的单次输出 token 上限
COMPRESSION_OUTPUT_MAX_TOKENS=2000
# memory_lookup 工具单次返回字符上限
LOOKUP_RESULT_CHARS=500
# 记忆检索携带的最近消息条数
MEMORY_RECENT_MESSAGES=5
